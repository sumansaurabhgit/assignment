# Environment Configuration for Voicemail Detection Backend

# Deepgram API Key for Speech-to-Text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key for LLM classification
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3001

# Audio Processing Configuration
# Frame size in milliseconds for streaming simulation
FRAME_SIZE_MS=50

# Beep Detection Configuration
# Frequency range for typical voicemail beeps (Hz)
BEEP_MIN_FREQ=1000
BEEP_MAX_FREQ=1400
# Energy threshold for beep detection (relative to frame energy)
BEEP_ENERGY_THRESHOLD=0.3

# Silence Detection Configuration
# RMS threshold below which audio is considered silence
SILENCE_THRESHOLD=0.01
# Duration of sustained silence for fallback trigger (ms)
LONG_SILENCE_DURATION_MS=1200
# Short silence duration for LLM+silence combo (ms)
SHORT_SILENCE_DURATION_MS=400

# LLM Configuration
# Model to use for greeting completion classification
OPENAI_MODEL=gpt-3.5-turbo
